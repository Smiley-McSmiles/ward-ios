default_platform(:ios)

platform :ios do
  desc "Build an App Store archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
    build_app(
      project: "Ward.xcodeproj",
      scheme: "Ward",
      configuration: "Release",
      output_directory: "build/fastlane",
      output_name: "Ward.ipa",
      export_method: "app-store-connect",
      export_options: "ExportOptions.plist",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      beta_app_description: "Ward for iOS beta",
      changelog: File.exist?("fastlane/metadata/en-US/release_notes.txt") ? File.read("fastlane/metadata/en-US/release_notes.txt") : "Bug fixes and polish."
    )
  end

  desc "Build and upload a release for App Store review without auto-submitting"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
    build_app(
      project: "Ward.xcodeproj",
      scheme: "Ward",
      configuration: "Release",
      output_directory: "build/fastlane",
      output_name: "Ward.ipa",
      export_method: "app-store-connect",
      export_options: "ExportOptions.plist",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: false,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Download and verify the latest TestFlight build number"
  lane :build_number do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
    latest_testflight_build_number(api_key: api_key)
  end
end
